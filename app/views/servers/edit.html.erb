<% content_for :title, "Edit #{@server.name}" %>

<%= render Ui::PageHeaderComponent.new(
      description: @scope.description,
      eyebrow: @project ? @project.relative_path : 'User scope',
      title: @server.name
    ) %>

<%= render Ui::CardComponent.new(accent: @scope.accent, subtitle: @scope.location, title: 'Server') do %>
  <%= render ServerFormComponent.new(project: @project,
                                     scope: @scope,
                                     server: @server,
                                     url: server_path(@server.name, project: @project&.path, scope: @scope.key)) %>
<% end %>

<%= render Ui::CardComponent.new(subtitle: 'Exactly what will be written for this server.', title: 'JSON') do %>
  <%= render JsonBlockComponent.new(value: { @server.name => @server.to_config }) %>
<% end %>
