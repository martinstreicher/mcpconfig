<article class="flex h-full flex-col overflow-hidden rounded-xl border bg-white dark:bg-slate-900/60 <%= accent(server.scope.accent, :border) %>"
         data-controller="reveal"
         data-server-name="<%= server.name %>">
  <div class="h-1 shrink-0 <%= accent(server.scope.accent, :bar) %>"></div>

  <%# Grows to fill the row so every card's footer lands on the same line. %>
  <div class="flex-1 pb-3">
    <div class="flex flex-wrap items-start justify-between gap-3 px-4 pt-3">
      <div class="min-w-0">
        <h3 class="truncate font-mono text-sm font-semibold text-slate-900 dark:text-slate-50"><%= server.name %></h3>

        <p class="mt-1 truncate font-mono text-xs text-slate-500 dark:text-slate-400" title="<%= server.summary %>">
          <%= server.summary.presence || 'No command configured' %>
        </p>
      </div>

      <div class="flex shrink-0 flex-wrap items-center gap-1.5">
        <%= render Ui::BadgeComponent.new(accent: transport_accent, label: server.transport) %>
        <%= render ScopeBadgeComponent.new(scope: server.scope) if show_scope %>

        <% if overlap %>
          <%= link_to overlaps_path(anchor: overlap.id),
                      class: "inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-medium #{accent(overlap.duplicate? ? 'slate' : 'rose', :chip)}",
                      title: overlap.summary do %>
            <%= overlap.duplicate? ? 'Duplicate' : 'Overridden' %>
          <% end %>
        <% end %>
      </div>
    </div>

    <% if server.warnings.any? %>
      <div class="mx-4 mt-3 rounded-lg border border-amber-300 bg-amber-50 px-3 py-2 dark:border-amber-900 dark:bg-amber-950/40">
        <ul class="space-y-1">
          <% server.warnings.each do |warning| %>
            <li class="text-xs text-amber-900 dark:text-amber-200">
              <span class="font-medium"><%= warning.message %></span>

              <% if warning.suggestion.present? %>
                <span class="opacity-80"><%= warning.suggestion %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <% if server.args.any? %>
      <div class="px-4 pt-3">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500">Arguments</p>

        <div class="mt-1 flex flex-wrap gap-1">
          <% server.args.each do |arg| %>
            <span class="rounded-sm bg-slate-100 px-1.5 py-0.5 font-mono text-xs text-slate-700 dark:bg-slate-800 dark:text-slate-300"><%= arg %></span>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if env_pairs.any? %>
      <div class="px-4 pt-3">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500">Environment</p>

        <dl class="mt-1 space-y-0.5">
          <% env_pairs.each do |key, value| %>
            <div class="flex items-baseline gap-2 text-xs">
              <dt class="shrink-0 font-mono text-slate-500 dark:text-slate-400"><%= key %></dt>

              <dd class="min-w-0 truncate font-mono text-slate-700 dark:text-slate-300">
                <% if secret?(key) %>
                  <span data-reveal-target="masked"><%= masked(value) %></span>
                  <span class="hidden" data-reveal-target="plain"><%= value %></span>
                  <button class="ml-1 text-slate-400 underline decoration-dotted hover:text-slate-600 dark:hover:text-slate-200"
                          data-action="reveal#toggle"
                          type="button">show</button>
                <% else %>
                  <%= value %>
                <% end %>
              </dd>
            </div>
          <% end %>
        </dl>
      </div>
    <% end %>

    <% if server.headers.any? %>
      <div class="px-4 pt-3">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500">Headers</p>
        <p class="mt-1 font-mono text-xs text-slate-600 dark:text-slate-300"><%= server.headers.keys.sort.join(', ') %></p>
      </div>
    <% end %>
  </div>

  <footer class="mt-auto flex items-center justify-between gap-2 border-t border-slate-200 px-4 py-2 dark:border-slate-800">
    <div class="flex items-center gap-1">
      <%= render Ui::ButtonComponent.new(href: edit_path, label: 'Edit', variant: :ghost) %>
      <%= render Ui::ButtonComponent.new(href: copy_path, label: 'Copy to…', variant: :ghost) %>
    </div>

    <%= button_to 'Remove',
                  delete_path,
                  class: 'rounded-lg border border-transparent px-3 py-1.5 text-sm font-medium text-rose-600 transition-colors hover:bg-rose-50 dark:text-rose-400 dark:hover:bg-rose-950/50',
                  form: { data: { turbo_confirm: "Remove #{server.name} from #{server.scope.name.downcase} scope?" } },
                  method: :delete %>
  </footer>
</article>
