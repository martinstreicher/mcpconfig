<article class="overflow-hidden rounded-xl border bg-white dark:bg-slate-900/60 <%= accent(accent_name, :border) %>" id="<%= overlap.id %>">
  <div class="h-1 <%= accent(accent_name, :bar) %>"></div>

  <div class="flex flex-wrap items-start justify-between gap-3 px-4 pt-3">
    <div class="min-w-0">
      <h3 class="font-mono text-sm font-semibold text-slate-900 dark:text-slate-50"><%= overlap.name %></h3>

      <% if show_project %>
        <p class="mt-0.5 truncate font-mono text-xs text-slate-500 dark:text-slate-400">
          <%= link_to overlap.project.relative_path, project_path(path: overlap.project.path), class: 'hover:underline' %>
        </p>
      <% end %>
    </div>

    <%= render Ui::BadgeComponent.new(accent: accent_name, label: headline) %>
  </div>

  <p class="px-4 pt-2 text-sm text-slate-600 dark:text-slate-300"><%= overlap.summary %></p>

  <div class="mt-3 divide-y divide-slate-200 border-t border-slate-200 dark:divide-slate-800 dark:border-slate-800">
    <% overlap.servers.each_with_index do |server, index| %>
      <div class="flex flex-wrap items-center justify-between gap-3 px-4 py-2 <%= 'opacity-60' if index.positive? %>">
        <div class="flex min-w-0 items-center gap-2">
          <%= render ScopeBadgeComponent.new(scope: server.scope, with_location: true) %>

          <span class="truncate font-mono text-xs text-slate-600 dark:text-slate-300"><%= server.summary %></span>
        </div>

        <div class="flex shrink-0 items-center gap-2">
          <% if index.zero? %>
            <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400">in effect</span>
          <% else %>
            <span class="text-xs text-slate-400 dark:text-slate-500">shadowed</span>
          <% end %>

          <%= link_to 'Edit', edit_path_for(server), class: 'text-xs text-slate-500 underline hover:text-slate-800 dark:hover:text-slate-200' %>
        </div>
      </div>
    <% end %>
  </div>

  <% if overlap.differences.any? %>
    <div class="border-t border-slate-200 px-4 py-3 dark:border-slate-800">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500">Differences</p>

      <table class="mt-2 w-full text-left text-xs">
        <thead>
          <tr class="text-slate-400 dark:text-slate-500">
            <th class="pb-1 pr-3 font-medium">Field</th>

            <% overlap.servers.each do |server| %>
              <th class="pb-1 pr-3 font-medium"><%= server.scope.name %></th>
            <% end %>
          </tr>
        </thead>

        <tbody class="align-top">
          <% overlap.differences.each do |difference| %>
            <tr class="border-t border-slate-100 dark:border-slate-800">
              <td class="py-1 pr-3 font-medium text-slate-600 dark:text-slate-300"><%= difference[:field] %></td>

              <% overlap.servers.each do |server| %>
                <td class="py-1 pr-3 font-mono text-slate-500 dark:text-slate-400">
                  <%= display_value(difference[:values][server.scope.key]) %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</article>
