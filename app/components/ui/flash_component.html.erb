<div class="space-y-2" data-controller="dismiss">
  <% messages.each do |key, message| %>
    <div class="flex items-start justify-between gap-4 rounded-lg border px-4 py-3 text-sm <%= style_for(key) %>"
         data-dismiss-target="item"
         role="<%= key == 'alert' ? 'alert' : 'status' %>">
      <span><%= message %></span>

      <button class="shrink-0 opacity-60 hover:opacity-100" data-action="dismiss#close" type="button" aria-label="Dismiss">
        &times;
      </button>
    </div>
  <% end %>
</div>
