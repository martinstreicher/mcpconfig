<header class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <% if eyebrow.present? %>
      <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 dark:text-slate-500"><%= eyebrow %></p>
    <% end %>

    <h1 class="mt-1 text-2xl font-semibold text-slate-900 dark:text-slate-50"><%= title %></h1>

    <% if description.present? %>
      <p class="mt-1 max-w-2xl text-sm text-slate-500 dark:text-slate-400"><%= description %></p>
    <% end %>
  </div>

  <% if actions? %>
    <div class="flex flex-wrap items-center gap-2"><%= safe_join(actions) %></div>
  <% end %>
</header>
