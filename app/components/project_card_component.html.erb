<article class="overflow-hidden rounded-xl border bg-white transition-shadow hover:shadow-md dark:bg-slate-900/60 <%= accent(accent_name, :border) %>">
  <div class="h-1 <%= accent(accent_name, :bar) %>"></div>

  <div class="p-4">
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <h3 class="truncate text-sm font-semibold text-slate-900 dark:text-slate-50">
          <%= link_to project.display_name, path, class: 'hover:underline' %>
        </h3>

        <p class="mt-0.5 truncate font-mono text-xs text-slate-500 dark:text-slate-400" title="<%= project.path %>">
          <%= project.relative_path %>
        </p>
      </div>

      <% if missing_directory? %>
        <%= render Ui::BadgeComponent.new(accent: 'slate', label: 'Not on disk',
                                          title: "This path is remembered in #{Mcp::Scope.user_config_display} " \
                                                 'but no longer exists.') %>
      <% end %>
    </div>

    <div class="mt-3 flex flex-wrap items-center gap-1.5">
      <% if project.project_servers.any? %>
        <%= render Ui::BadgeComponent.new(accent: 'emerald',
                                          label: "#{pluralize(project.project_servers.size, 'server')} in .mcp.json") %>
      <% end %>

      <% if project.local_servers.any? %>
        <%= render Ui::BadgeComponent.new(accent: 'amber',
                                          label: "#{pluralize(project.local_servers.size, 'local server')}") %>
      <% end %>

      <% if overrides.any? %>
        <%= render Ui::BadgeComponent.new(accent: 'rose',
                                          label: "#{pluralize(overrides.size, 'override')}",
                                          title: 'This project redefines a user-scoped server differently.') %>
      <% end %>

      <% if duplicates.any? %>
        <%= render Ui::BadgeComponent.new(accent: 'slate',
                                          label: "#{pluralize(duplicates.size, 'duplicate')}",
                                          title: 'Defined here exactly as it is at user scope, so this copy adds nothing.') %>
      <% end %>
    </div>

    <% if project.last_run_at %>
      <p class="mt-3 text-xs text-slate-400 dark:text-slate-500">
        Last used <%= time_ago_in_words(project.last_run_at) %> ago
      </p>
    <% end %>
  </div>
</article>
