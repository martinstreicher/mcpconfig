# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# Temporary files generated by your text editor or operating system.
.DS_Store
*.swp
*~

# Ignore bundler config.
/.bundle

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
!/tmp/pids
/tmp/pids/*
!/tmp/pids/.keep

# Ignore the Tailwind build output.
/app/assets/builds/*
!/app/assets/builds/.keep

# Ignore the master key for decrypting credentials and more.
/config/master.key

# Gems built from source for environments without access to rubygems.org.
/.local-gems
